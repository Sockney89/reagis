enum RValue {
    StrV(Str),
    ListV(List[Str]),
    SetV(Set[Str]),
    HashV(Map[Str, Str]),
    JsonV(Str),
    SortedSetV(Map[Str, Float]),
    IntV(Int)
}

enum RResult {
    RSimple(Str),
    RInt(Int),
    RBulk(Str),
    RNil,
    RArr(List[Str]),
    RHashArr(Map[Str, Str]),
    RErr(Str)
}

struct ReagisEngine {}

impl ReagisEngine {
    fn tokenize(self, line: Str) -> List[Str] {
        let mut tokens: List[Str] = []
        let mut i = 0
        let n = line.length()
        let mut cur: List[Str] = []
        let mut in_quote = false
        while i < n {
            let c = line[i]
            if in_quote {
                if c == "\\" {
                    i = i + 1
                    if i < n {
                        cur.append(line[i])
                    }
                } else if c == "\"" {
                    tokens.append(cur.join(""))
                    cur = []
                    in_quote = false
                } else {
                    cur.append(c)
                }
            } else {
                if c == " " || c == "\t" || c == "\r" || c == "\n" {
                    if cur.length() > 0 {
                        tokens.append(cur.join(""))
                        cur = []
                    }
                } else if c == "\"" {
                    if cur.length() > 0 {
                        tokens.append(cur.join(""))
                        cur = []
                    }
                    in_quote = true
                } else {
                    cur.append(c)
                }
            }
            i = i + 1
        }
        if cur.length() > 0 {
            tokens.append(cur.join(""))
        }
        return tokens
    }
    fn valid_key(self, k: Str) -> Bool {
        if k == "" {
            return false
        }
        if k.length() > 256 {
            return false
        }
        let mut i = 0
        while i < k.length() {
            let c = k[i]
            let good = (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || c == "_" || c == ":" || c == "-" || c == "."
            if !good {
                return false
            }
            i = i + 1
        }
        return true
    }

fn parse_int(self, s: Str) -> Int {
        match s.to_int() {
            ok(n) => { return n }
            err(e) => { return 0 }
        }
    }

    fn parse_float(self, s: Str) -> Float {
        match s.to_float() {
            ok(f) => { return f }
            err(e) => { return 0.0 }
        }
    }

    fn parse_rest_command(self, body: Str) -> List[Str] {
        let mut tokens: List[Str] = []
        let jp = JsonParser {}
        match jp.parse(body) {
            ok(j) => {
                let mut cmd = ""
                let mut args: List[Str] = []
                match jp.as_obj(j) {
                    some(obj) => {
                        if obj.contains("cmd") {
                            match obj["cmd"] {
                                Json::Str(s) => { cmd = s }
                                _ => {}
                            }
                        }
                        if obj.contains("args") {
                            match jp.as_arr(obj["args"]) {
                                some(arr) => {
                                    let mut i = 0
                                    while i < arr.length() {
                                        let v = arr[i]
                                        match v {
                                            Json::Str(s) => { args.append(s) }
                                            Json::Num(f) => { args.append(str(f)) }
                                            Json::Bool(b) => {
                                                if b { args.append("true") } else { args.append("false") }
                                            }
                                            _ => { args.append("") }
                                        }
                                        i = i + 1
                                    }
                                }
                                none => {}
                            }
                        }
                    }
                    none => {
                        match jp.as_arr(j) {
                            some(arr) => {
                                if arr.length() > 0 {
                                    match arr[0] {
                                        Json::Str(s) => { cmd = s }
                                        _ => {}
                                    }
                                    let mut i = 1
                                    while i < arr.length() {
                                        let v = arr[i]
                                        match v {
                                            Json::Str(s) => { args.append(s) }
                                            Json::Num(f) => { args.append(str(f)) }
                                            Json::Bool(b) => {
                                                if b { args.append("true") } else { args.append("false") }
                                            }
                                            _ => { args.append("") }
                                        }
                                        i = i + 1
                                    }
                                }
                            }
                            none => {}
                        }
                    }
                }
                if cmd != "" {
                    tokens.append(cmd)
                    loop a in args {
                        tokens.append(a)
                    }
                }
            }
            err(m) => {}
        }
        return tokens
    }

    fn exec(self, mut store: Map[Str, RValue], tokens: List[Str]) -> RResult {
        if tokens.length() == 0 {
            return RResult::RErr("empty command")
        }
        let cmd = tokens[0].to_upper()
        match cmd {
            "PING" => { return RResult::RSimple("PONG") }
            "ECHO" => {
                if tokens.length() < 2 || tokens.length() > 2 {
                    return RResult::RErr("wrong number of args")
                }
                return RResult::RBulk(tokens[1])
            }
            "SET" => {
                if tokens.length() < 3 || tokens.length() > 3 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                if !self.valid_key(key) {
                    return RResult::RErr("invalid key")
                }
                let val = tokens[2]
                store.insert(key, RValue::StrV(val))
                return RResult::RSimple("OK")
            }
            "GET" => {
                if tokens.length() < 2 || tokens.length() > 2 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                if !store.contains(key) {
                    return RResult::RNil
                }
                match store[key] {
                    RValue::StrV(v) => { return RResult::RBulk(v) }
                    _ => { return RResult::RErr("WRONGTYPE") }
                }
            }
            "DEL" => {
                let mut count = 0
                let mut i = 1
                while i < tokens.length() {
                    let k = tokens[i]
                    if store.contains(k) {
                        store.remove(k)
                        count = count + 1
                    }
                    i = i + 1
                }
                return RResult::RInt(count)
            }
            "EXISTS" => {
                if tokens.length() < 2 || tokens.length() > 2 {
                    return RResult::RErr("wrong number of args")
                }
                if store.contains(tokens[1]) {
                    return RResult::RInt(1)
                }
                return RResult::RInt(0)
            }
            "INCR" => {
                if tokens.length() < 2 || tokens.length() > 2 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                if !store.contains(key) {
                    store.insert(key, RValue::StrV("1"))
                    return RResult::RInt(1)
                }
                match store[key] {
                    RValue::StrV(v) => {
                        match v.to_int() {
                            ok(n) => {
                                let nv = n + 1
                                store.insert(key, RValue::StrV(str(nv)))
                                return RResult::RInt(nv)
                            }
                            err(e) => { return RResult::RErr("invalid integer") }
                        }
                    }
                    _ => { return RResult::RErr("WRONGTYPE") }
                }
            }
            "DECR" => {
                if tokens.length() < 2 || tokens.length() > 2 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                if !store.contains(key) {
                    store.insert(key, RValue::StrV("-1"))
                    return RResult::RInt(-1)
                }
                match store[key] {
                    RValue::StrV(v) => {
                        match v.to_int() {
                            ok(n) => {
                                let nv = n - 1
                                store.insert(key, RValue::StrV(str(nv)))
                                return RResult::RInt(nv)
                            }
                            err(e) => { return RResult::RErr("invalid integer") }
                        }
                    }
                    _ => { return RResult::RErr("WRONGTYPE") }
                }
            }
            "APPEND" => {
                if tokens.length() < 3 || tokens.length() > 3 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                let val = tokens[2]
                if !store.contains(key) {
                    store.insert(key, RValue::StrV(val))
                    return RResult::RInt(val.length())
                }
                match store[key] {
                    RValue::StrV(v) => {
                        let nv = v + val
                        store.insert(key, RValue::StrV(nv))
                        return RResult::RInt(nv.length())
                    }
                    _ => { return RResult::RErr("WRONGTYPE") }
                }
            }
            "STRLEN" => {
                if tokens.length() < 2 || tokens.length() > 2 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                if !store.contains(key) {
                    return RResult::RInt(0)
                }
                match store[key] {
                    RValue::StrV(v) => { return RResult::RInt(v.length()) }
                    _ => { return RResult::RErr("WRONGTYPE") }
                }
            }
            "LPUSH" => {
                if tokens.length() < 3 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                let mut lst: List[Str] = []
                if store.contains(key) {
                    match store[key] {
                        RValue::ListV(v) => { lst = v }
                        _ => { return RResult::RErr("WRONGTYPE") }
                    }
                }
let mut vals: List[Str] = []
let mut i = 2
while i < tokens.length() {
    vals.append(tokens[i])
    i = i + 1
}
let mut rev: List[Str] = []
let mut j = vals.length() - 1
while j >= 0 {
    rev.append(vals[j])
    j = j - 1
}
let mut newlst: List[Str] = []
loop v in rev {
    newlst.append(v)
}
loop v in lst {
    newlst.append(v)
}
lst = newlst
                store.insert(key, RValue::ListV(lst))
                return RResult::RInt(lst.length())
            }
            "RPUSH" => {
                if tokens.length() < 3 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                let mut lst: List[Str] = []
                if store.contains(key) {
                    match store[key] {
                        RValue::ListV(v) => { lst = v }
                        _ => { return RResult::RErr("WRONGTYPE") }
                    }
                }
                let mut i = 2
                while i < tokens.length() {
                    lst.append(tokens[i])
                    i = i + 1
                }
                store.insert(key, RValue::ListV(lst))
                return RResult::RInt(lst.length())
            }
            "LPOP" => {
                if tokens.length() < 2 || tokens.length() > 2 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                if !store.contains(key) {
                    return RResult::RNil
                }
                match store[key] {
                    RValue::ListV(v) => {
                        if v.length() == 0 {
                            store.remove(key)
                            return RResult::RNil
                        }
                        let first = v[0]
                        let rest = v.slice(1, v.length())
                        if rest.length() == 0 {
                            store.remove(key)
                        } else {
                            store.insert(key, RValue::ListV(rest))
                        }
                        return RResult::RBulk(first)
                    }
                    _ => { return RResult::RErr("WRONGTYPE") }
                }
            }
            "RPOP" => {
                if tokens.length() < 2 || tokens.length() > 2 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                if !store.contains(key) {
                    return RResult::RNil
                }
                match store[key] {
                    RValue::ListV(v) => {
                        if v.length() == 0 {
                            store.remove(key)
                            return RResult::RNil
                        }
                        let mut lst = v
                        let last = lst.pop()
                        if lst.length() == 0 {
                            store.remove(key)
                        } else {
                            store.insert(key, RValue::ListV(lst))
                        }
                        return RResult::RBulk(last)
                    }
                    _ => { return RResult::RErr("WRONGTYPE") }
                }
            }
            "LLEN" => {
                if tokens.length() < 2 || tokens.length() > 2 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                if !store.contains(key) {
                    return RResult::RInt(0)
                }
                match store[key] {
                    RValue::ListV(v) => { return RResult::RInt(v.length()) }
                    _ => { return RResult::RErr("WRONGTYPE") }
                }
            }
            "LRANGE" => {
                if tokens.length() < 4 || tokens.length() > 4 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                if !store.contains(key) {
                    return RResult::RArr([])
                }
                match store[key] {
                    RValue::ListV(v) => {
                        let start = self.parse_int(tokens[2])
                        let stop = self.parse_int(tokens[3])
                        let mut s = start
                        let mut e = stop
                        let n = v.length()
                        if s < 0 { s = n + s }
                        if e < 0 { e = n + e }
                        if s < 0 { s = 0 }
                        if e >= n { e = n - 1 }
                        let mut out: List[Str] = []
                        if s <= e {
                            let mut i = s
                            while i <= e && i < n {
                                out.append(v[i])
                                i = i + 1
                            }
                        }
                        return RResult::RArr(out)
                    }
                    _ => { return RResult::RErr("WRONGTYPE") }
                }
            }
            "LINDEX" => {
                if tokens.length() < 3 || tokens.length() > 3 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                if !store.contains(key) {
                    return RResult::RNil
                }
                match store[key] {
                    RValue::ListV(v) => {
                        let idx = self.parse_int(tokens[2])
                        let n = v.length()
                        let mut i = idx
                        if i < 0 { i = n + i }
                        if i < 0 || i >= n {
                            return RResult::RNil
                        }
                        return RResult::RBulk(v[i])
                    }
                    _ => { return RResult::RErr("WRONGTYPE") }
                }
            }
            "SADD" => {
                if tokens.length() < 3 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                let mut s: Set[Str] = Set[Str] { data: {} }
                if store.contains(key) {
                    match store[key] {
                        RValue::SetV(v) => { s = v }
                        _ => { return RResult::RErr("WRONGTYPE") }
                    }
                }
                let mut added = 0
                let mut i = 2
                while i < tokens.length() {
                    if !s.contains(tokens[i]) {
                        s.add(tokens[i])
                        added = added + 1
                    }
                    i = i + 1
                }
                store.insert(key, RValue::SetV(s))
                return RResult::RInt(added)
            }
            "SREM" => {
                if tokens.length() < 3 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                if !store.contains(key) {
                    return RResult::RInt(0)
                }
                match store[key] {
                    RValue::SetV(v) => {
                        let mut s = v
                        let mut removed = 0
                        let mut i = 2
                        while i < tokens.length() {
                            if s.remove(tokens[i]) {
                                removed = removed + 1
                            }
                            i = i + 1
                        }
                        if s.len() == 0 {
                            store.remove(key)
                        } else {
                            store.insert(key, RValue::SetV(s))
                        }
                        return RResult::RInt(removed)
                    }
                    _ => { return RResult::RErr("WRONGTYPE") }
                }
            }
            "SMEMBERS" => {
                if tokens.length() < 2 || tokens.length() > 2 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                if !store.contains(key) {
                    return RResult::RArr([])
                }
                match store[key] {
                    RValue::SetV(v) => {
                        let ks = v.data.keys()
                        return RResult::RArr(ks)
                    }
                    _ => { return RResult::RErr("WRONGTYPE") }
                }
            }
            "SCARD" => {
                if tokens.length() < 2 || tokens.length() > 2 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                if !store.contains(key) {
                    return RResult::RInt(0)
                }
                match store[key] {
                    RValue::SetV(v) => { return RResult::RInt(v.len()) }
                    _ => { return RResult::RErr("WRONGTYPE") }
                }
            }
            "SISMEMBER" => {
                if tokens.length() < 3 || tokens.length() > 3 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                if !store.contains(key) {
                    return RResult::RInt(0)
                }
                match store[key] {
                    RValue::SetV(v) => {
                        if v.contains(tokens[2]) {
                            return RResult::RInt(1)
                        }
                        return RResult::RInt(0)
                    }
                    _ => { return RResult::RErr("WRONGTYPE") }
                }
            }
            "HSET" => {
                if tokens.length() < 4 || tokens.length() > 4 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                let field = tokens[2]
                let value = tokens[3]
                let mut m: Map[Str, Str] = {}
                if store.contains(key) {
                    match store[key] {
                        RValue::HashV(v) => { m = v }
                        _ => { return RResult::RErr("WRONGTYPE") }
                    }
                }
                let mut added = 0
                if !m.contains(field) {
                    added = 1
                }
                m.insert(field, value)
                store.insert(key, RValue::HashV(m))
                return RResult::RInt(added)
            }
            "HGET" => {
                if tokens.length() < 3 || tokens.length() > 3 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                if !store.contains(key) {
                    return RResult::RNil
                }
                match store[key] {
                    RValue::HashV(m) => {
                        if m.contains(tokens[2]) {
                            return RResult::RBulk(m[tokens[2]])
                        }
                        return RResult::RNil
                    }
                    _ => { return RResult::RErr("WRONGTYPE") }
                }
            }
            "HDEL" => {
                if tokens.length() < 3 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                if !store.contains(key) {
                    return RResult::RInt(0)
                }
                match store[key] {
                    RValue::HashV(m) => {
                        let mut mm = m
                        let mut removed = 0
                        let mut i = 2
                        while i < tokens.length() {
                            if mm.contains(tokens[i]) {
                                mm.remove(tokens[i])
                                removed = removed + 1
                            }
                            i = i + 1
                        }
                        if mm.length() == 0 {
                            store.remove(key)
                        } else {
                            store.insert(key, RValue::HashV(mm))
                        }
                        return RResult::RInt(removed)
                    }
                    _ => { return RResult::RErr("WRONGTYPE") }
                }
            }
            "HGETALL" => {
                if tokens.length() < 2 || tokens.length() > 2 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                if !store.contains(key) {
                    return RResult::RArr([])
                }
                match store[key] {
                    RValue::HashV(m) => {
                        let ks = m.keys()
                        let mut out: List[Str] = []
                        loop k in ks {
                            out.append(k)
                            out.append(m[k])
                        }
                        return RResult::RArr(out)
                    }
                    _ => { return RResult::RErr("WRONGTYPE") }
                }
            }
            "HLEN" => {
                if tokens.length() < 2 || tokens.length() > 2 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                if !store.contains(key) {
                    return RResult::RInt(0)
                }
                match store[key] {
                    RValue::HashV(m) => { return RResult::RInt(m.length()) }
                    _ => { return RResult::RErr("WRONGTYPE") }
                }
            }
            "JSON.SET" => {
                if tokens.length() < 3 || tokens.length() > 3 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                let raw = tokens[2]
                let jp = JsonParser {}
                match jp.parse(raw) {
                    ok(j) => {
                        store.insert(key, RValue::JsonV(raw))
                        return RResult::RSimple("OK")
                    }
                    err(m) => { return RResult::RErr("invalid json") }
                }
            }
            "JSON.GET" => {
                if tokens.length() < 2 || tokens.length() > 2 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                if !store.contains(key) {
                    return RResult::RNil
                }
                match store[key] {
                    RValue::JsonV(v) => { return RResult::RBulk(v) }
                    _ => { return RResult::RErr("WRONGTYPE") }
                }
            }
            "ZADD" => {
                if tokens.length() < 4 || tokens.length() > 4 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                let score = self.parse_float(tokens[2])
                let member = tokens[3]
                let mut m: Map[Str, Float] = {}
                if store.contains(key) {
                    match store[key] {
                        RValue::SortedSetV(v) => { m = v }
                        _ => { return RResult::RErr("WRONGTYPE") }
                    }
                }
                m.insert(member, score)
                store.insert(key, RValue::SortedSetV(m))
                return RResult::RInt(1)
            }
            "ZSCORE" => {
                if tokens.length() < 3 || tokens.length() > 3 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                if !store.contains(key) {
                    return RResult::RNil
                }
                match store[key] {
                    RValue::SortedSetV(m) => {
                        if m.contains(tokens[2]) {
                            return RResult::RBulk(str(m[tokens[2]]))
                        }
                        return RResult::RNil
                    }
                    _ => { return RResult::RErr("WRONGTYPE") }
                }
            }
            "ZRANGE" => {
                if tokens.length() < 2 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                if !store.contains(key) {
                    return RResult::RArr([])
                }
                match store[key] {
                    RValue::SortedSetV(m) => {
                        let members = m.keys()
                        // bubble sort by score
                        let n = members.length()
                        let mut arr: List[Str] = []
                        let mut i = 0
                        while i < n {
                            arr.append(members[i])
                            i = i + 1
                        }
let sorted = members.sort(|a: Str, b: Str| m[a] > m[b])
arr = sorted
                        return RResult::RArr(arr)
                    }
                    _ => { return RResult::RErr("WRONGTYPE") }
                }
            }
            "FLUSHALL" => {
                // clear store: rebuild empty map
                let ks = store.keys()
loop k in ks {
    store.remove(k)
}
                return RResult::RSimple("OK")
            }
            "DBSIZE" => {
                return RResult::RInt(store.length())
            }
            "TYPE" => {
                if tokens.length() < 2 || tokens.length() > 2 {
                    return RResult::RErr("wrong number of args")
                }
                let key = tokens[1]
                if !store.contains(key) {
                    return RResult::RSimple("none")
                }
                match store[key] {
                    RValue::StrV(v) => { return RResult::RSimple("string") }
                    RValue::ListV(v) => { return RResult::RSimple("list") }
                    RValue::SetV(v) => { return RResult::RSimple("set") }
                    RValue::HashV(v) => { return RResult::RSimple("hash") }
                    RValue::JsonV(v) => { return RResult::RSimple("json") }
                    RValue::SortedSetV(v) => { return RResult::RSimple("zset") }
                    RValue::IntV(v) => { return RResult::RSimple("integer") }
                }
            }
            _ => { return RResult::RErr("unknown command") }
        }
    }

    fn format(self, r: RResult) -> Str {
        match r {
            RResult::RSimple(s) => { return "+" + s + "\r\n" }
            RResult::RInt(n) => { return ":" + str(n) + "\r\n" }
            RResult::RNil => { return "$-1\r\n" }
            RResult::RBulk(s) => {
                let n = s.length()
                return "$" + str(n) + "\r\n" + s + "\r\n"
            }
            RResult::RArr(xs) => {
                let mut sb = StrBuf { parts: [] }
                sb.append("*")
                sb.append_int(xs.length())
                sb.append("\r\n")
                loop v in xs {
                    sb.append("$")
                    sb.append_int(v.length())
                    sb.append("\r\n")
                    sb.append(v)
                    sb.append("\r\n")
                }
                return sb.to_string()
            }
            RResult::RHashArr(m) => {
                let ks = m.keys()
                let mut sb = StrBuf { parts: [] }
                sb.append("*")
                sb.append_int(ks.length() * 2)
                sb.append("\r\n")
                loop k in ks {
                    let v = m[k]
                    sb.append("$")
                    sb.append_int(k.length())
                    sb.append("\r\n")
                    sb.append(k)
                    sb.append("\r\n")
                    sb.append("$")
                    sb.append_int(v.length())
                    sb.append("\r\n")
                    sb.append(v)
                    sb.append("\r\n")
                }
                return sb.to_string()
            }
            RResult::RErr(s) => { return "-" + s + "\r\n" }
        }
    }
    fn to_json(self, r: RResult) -> Str {
        let h = Http {}
        match r {
            RResult::RSimple(s) => { return "\{\"ok\":true,\"type\":\"simple\",\"value\":\"" + h.json_escape(s) + "\"\}" }
            RResult::RInt(n) => { return "\{\"ok\":true,\"type\":\"integer\",\"value\":" + str(n) + "\}" }
            RResult::RNil => { return "\{\"ok\":true,\"type\":\"nil\"\}" }
            RResult::RBulk(s) => { return "\{\"ok\":true,\"type\":\"bulk\",\"value\":\"" + h.json_escape(s) + "\"\}" }
            RResult::RArr(xs) => {
                let mut sb = StrBuf { parts: [] }
                sb.append("\{\"ok\":true,\"type\":\"array\",\"value\":[")
                let mut first = true
                loop v in xs {
                    if !first { sb.append(",") }
                    first = false
                    sb.append("\"")
                    sb.append(h.json_escape(v))
                    sb.append("\"")
                }
                sb.append("]\}")
                return sb.to_string()
            }
            RResult::RHashArr(m) => {
                let ks = m.keys()
                let mut sb = StrBuf { parts: [] }
                sb.append("\{\"ok\":true,\"type\":\"hash\",\"value\":\{")
                let mut first = true
                loop k in ks {
                    if !first { sb.append(",") }
                    first = false
                    let v = m[k]
                    sb.append("\"")
                    sb.append(h.json_escape(k))
                    sb.append("\":\"")
                    sb.append(h.json_escape(v))
                    sb.append("\"")
                }
                sb.append("\}\}")
                return sb.to_string()
            }
            RResult::RErr(s) => { return "\{\"ok\":false,\"error\":\"" + h.json_escape(s) + "\"\}" }
        }
    }
}

struct App {}

impl App {
    fn main(self) -> Int {
let mut mode = "tcp"
if argc() >= 2 {
    mode = arg(1)
}
let mut port_arg = 0
if argc() >= 3 {
    match arg(2).to_int() {
        ok(n) => { port_arg = n }
        err(e) => { port_arg = 0 }
    }
}
        if mode == "tcp" {
            let net = Net {}
            if net.init() != 0 {
                println("net init failed")
                return 1
            }
            let mut p = 6380
if port_arg > 0 {
    p = port_arg
}
            let l = net.listen("127.0.0.1", p)
            if l == null {
                println("listen failed")
                return 1
            }
            println("READY tcp " + str(net.port(l)))
            let engine = ReagisEngine {}
            let mut store: Map[Str, RValue] = {}
            loop {
                let conn = net.accept(l)
                if conn == null {
                    break
                }
                let mut buf = ""
                let mut running = true
                while running {
                    let mut line = ""
                    let mut got = false
                    while !got && running {
                        let chunk = net.recv(conn, 1024)
                        if chunk == "" {
                            running = false
                        } else {
                            buf = buf + chunk
                            let idx = buf.index_of("\n")
                            if idx >= 0 {
                                line = buf.substring(0, idx)
                                buf = buf.substring(idx + 1, buf.length())
                                got = true
                            }
                        }
                    }
                    if !running {
                        break
                    }
                    if !got {
                        break
                    }
                    if line.length() > 0 && line[line.length() - 1] == "\r" {
                        line = line.substring(0, line.length() - 1)
                    }
                    if line == "" {
                        continue
                    }
                    let tokens = engine.tokenize(line)
                    let mut res = RResult::RErr("empty")
if tokens.length() != 0 {
    res = engine.exec(store, tokens)
}
                    let resp = engine.format(res)
                    net.send(conn, resp)
                }
                net.close_conn(conn)
            }
            net.close_listener(l)
            return 0
        } else if mode == "rest" {
            let http = Http {}
            let mut p = 8080
if port_arg > 0 {
    p = port_arg
}
            let mut store: Map[Str, RValue] = {}
            let engine = ReagisEngine {}
            let handler = |req: Request| -> Response {
                let h = Http {}
                if req.path == "/health" {
                    return h.respond_json("\{\"status\":\"ok\"\}")
                }
                if req.method == "POST" && req.path == "/command" {
                    let tokens = engine.parse_rest_command(req.body)
                    if tokens.length() == 0 {
                        return h.respond_400()
                    }
                    let res = engine.exec(store, tokens)
                    return h.respond_json(engine.to_json(res))
                }
                if req.method == "GET" && req.path == "/get" {
                    let key = h.query_get(req, "key")
                    let tokens: List[Str] = ["GET", key]
                    let res = engine.exec(store, tokens)
                    return h.respond_json(engine.to_json(res))
                }
                if req.method == "GET" && req.path == "/health" {
                    return h.respond_json("\{\"status\":\"ok\"\}")
                }
                return h.respond_404()
            }
            println("READY rest " + str(p))
            let rc = http.serve(p, handler)
            return 0
        } else {
            println("usage: app [tcp|rest] [port]")
            return 1
        }
    }
}
